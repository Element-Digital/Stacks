<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Stacks.Ui"
        mc:Ignorable="d"
        x:Class="Stacks.Ui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Stacks"
        Width="980" Height="620"
        MinWidth="700" MinHeight="420"
        FontFamily="{StaticResource InterFontFamily}">

    <Window.KeyBindings>
        <KeyBinding Gesture="I" Command="{Binding InstallCommand}" />
        <KeyBinding Gesture="L" Command="{Binding LaunchCommand}" />
        <KeyBinding Gesture="O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Gesture="R" Command="{Binding RescanCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SystemRegionBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           FontSize="12"
                           Text="{Binding RootDirectory}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Stacks" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*">

            <Border Grid.Column="0" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,1,0">
                <ListBox x:Name="GamesList"
                         ItemsSource="{Binding Games}"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StatusGlyph}"
                                           ToolTip.Tip="{Binding StatusTooltip}"
                                           FontSize="14"
                                           Width="18"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Version}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <TextBlock Text="{Binding LastPlayedRelative}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PlayCount}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,4,0"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="20,16">

                <StackPanel Grid.Row="0" Spacing="6"
                            IsVisible="{Binding HasSelection}">
                    <TextBlock Text="{Binding SelectedGame.DisplayName}"
                               FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding SelectedGame.Version}"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{Binding SelectedGame.StatusTooltip}"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock>
                            <Run Text="Played " />
                            <Run Text="{Binding SelectedGame.PlayCount}" />
                            <Run Text="× · last " />
                            <Run Text="{Binding SelectedGame.LastPlayedRelative}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,16,0,0"
                        Padding="12" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        IsVisible="{Binding HasSelection}">
                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SelectedGame.LoadError}"
                                       Foreground="{DynamicResource SystemErrorTextColor}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedGame.LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedGame.Notes}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedGame.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedGame.FolderPath}"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="No game selected. Drop a stacks.json next to a game in this folder, or press R to rescan."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="{Binding !HasSelection}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button Content="Launch (L)" Command="{Binding LaunchCommand}" Classes="accent" />
                    <Button Content="Install (I)" Command="{Binding InstallCommand}" />
                    <Button Content="Open Folder (O)" Command="{Binding OpenFolderCommand}" />
                    <Button Content="Rescan (R)" Command="{Binding RescanCommand}" />
                </StackPanel>

            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           FontSize="12"
                           Text="↑↓ select · L launch · I install · O folder · R rescan · Esc quit" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           Classes.error="{Binding IsError}" />
            </DockPanel>
        </Border>

    </Grid>
</Window>
